# Keys the audit-log digest. Without it, a digest of a low-entropy value
# (a 9-digit taxpayer ID, a date of birth) can be brute-forced.
# Generate with: openssl rand -hex 32
AUDIT_DIGEST_SECRET=

# Both models deployed in one Azure AI Foundry project share a key. Named
# here as the single source; the two entries below point at it.
AZURE_API_KEY=

# The orchestrator + field-extraction model. Any OpenAI-compatible host
# (`/v1` is appended), so for Azure Foundry give the endpoint up to
# `/openai` -> baseURL becomes `.../openai/v1`. Unset, every turn degrades to
# the §11 notice, which looks identical to the model being down.
ORCHESTRATOR_ENDPOINT=https://example.services.ai.azure.com/openai
ORCHESTRATOR_MODEL=
ORCHESTRATOR_API_KEY=
# ORCHESTRATOR_EFFORT is filed with the provider as reasoningEffort. Defaults to
# `low`. `none` is the only value that stops a thinking model reasoning at us;
# `low` and `minimal` still spend most of the output on it.
ORCHESTRATOR_EFFORT=

# Mistral OCR at Azure Foundry. The code appends
# `/providers/mistral/azure/ocr`, so the endpoint is the bare project host.
# No default anywhere in the code: unset means the OCR gate skips rather than
# silently hitting a wrong box. Returns markdown; no bounding boxes.
OCR_ENDPOINT=https://example.services.ai.azure.com
OCR_MODEL=mistral-ocr-4-0
OCR_API_KEY=