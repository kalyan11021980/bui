# Keys the audit-log digest. Without it, a digest of a low-entropy value
# (a 9-digit taxpayer ID, a date of birth) can be brute-forced.
# Generate with: openssl rand -hex 32
AUDIT_DIGEST_SECRET=

# The orchestrator model. Unset, every turn degrades to the §11 notice, which
# looks identical to the model being down — so set these or the agent is dead.
# `local` is any OpenAI-compatible host (`/v1` is appended); it must support
# tool calls. ORCHESTRATOR_EFFORT is anthropic-only and defaults to `low`.
ORCHESTRATOR_PROVIDER=local
ORCHESTRATOR_ENDPOINT=
ORCHESTRATOR_MODEL=

# OCR host, OpenAI-compatible (LM Studio). No default anywhere in the code:
# unset means the OCR gate skips rather than silently hitting a wrong box.
OCR_ENDPOINT=
OCR_MODEL=
